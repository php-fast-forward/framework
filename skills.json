{
    "$schema": "https://raw.githubusercontent.com/roxblnfk/skills/master/resources/skills.schema.json",
    "target": ".agents/skills",
    "aliases": [],
    "discovery": false,
    "auto-sync": true,
    "vendor-sources": false,
    "dependencies": {
        "composer": {
            "trusted": [
                "fast-forward/clock",
                "fast-forward/config",
                "fast-forward/container",
                "fast-forward/defer",
                "fast-forward/enum",
                "fast-forward/event-dispatcher",
                "fast-forward/fork",
                "fast-forward/http",
                "fast-forward/http-client",
                "fast-forward/http-factory",
                "fast-forward/http-message",
                "fast-forward/iterators",
                "fast-forward/phpdoc-bootstrap-template"
            ],
            "trusted-replace": true
        }
    },
    "sources": [
        {
            "from": "github",
            "package": "php-fast-forward/changelog",
            "ref": "^0.3.0",
            "skills": [
                "fast-forward-changelog"
            ]
        }
    ]
}
