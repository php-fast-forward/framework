{
    "name": "fast-forward/framework",
    "description": "Fast Forward Framework is a lightweight and fast PHP framework designed for building modern web applications. It provides a simple and elegant API, making it easy to develop and maintain your projects.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Felipe Sayão Lobato Abreu",
            "email": "github@mentordosnerds.com"
        }
    ],
    "homepage": "https://github.com/php-fast-forward",
    "support": {
        "issues": "https://github.com/php-fast-forward/framework/issues",
        "source": "https://github.com/php-fast-forward/framework"
    },
    "require": {
        "php": "^8.3",
        "fast-forward/config": "^1.4",
        "fast-forward/container": "^1.5",
        "fast-forward/defer": "^1.0",
        "fast-forward/http": "^1.0",
        "fast-forward/iterators": "^1.0"
    },
    "require-dev": {
        "fast-forward/dev-tools": "dev-main"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "FastForward\\Framework\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FastForward\\Framework\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "fast-forward/dev-tools": true,
            "phpdocumentor/shim": true,
            "phpro/grumphp": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "grumphp": {
            "config-default-path": "vendor/fast-forward/dev-tools/grumphp.yml"
        }
    },
    "scripts": {
        "dev-tools": "dev-tools",
        "dev-tools:fix": "@dev-tools --fix"
    }
}
