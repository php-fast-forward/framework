        "issues": "https://github.com/php-fast-forward/framework/issues",
        "source": "https://github.com/php-fast-forward/framework"
    },
    "require": {
        "php": "^8.1",
        "fast-forward/config": "^1.0",
        "fast-forward/container": "^1.0"
